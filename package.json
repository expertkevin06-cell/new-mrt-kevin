{
  "name": "diagauto-pro",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "start": "npm run icons && node server/index.js",
    "dev": "node --watch server/index.js",
    "verify": "node scripts/auto-verify.mjs",
    "verify:live": "node scripts/auto-verify.mjs --live --base http://localhost:3000",
    "verify:prod": "node scripts/auto-verify.mjs --live --pwabuilder --strict",
    "pwabuilder:check": "node scripts/auto-verify.mjs --live --pwabuilder --strict",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:3000",
    "cap:init": "npx cap init \"DiagAuto Pro\" com.diagauto.pro --web-dir=public",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run icons && npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor-community/bluetooth-serial": "^6.1.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
