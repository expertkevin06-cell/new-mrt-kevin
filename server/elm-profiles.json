      "write": false,
      "description": "Lit une donnée DID dans un calculateur."
    },
    "0x2E": {
      "name": "WriteDataByIdentifier",
      "type": "write",
      "write": true,
      "description": "Écrit une donnée DID. Réservé administrateur et procédure documentée."
    },
    "0x2F": {
      "name": "InputOutputControlByIdentifier",
      "type": "control",
      "write": true,
      "description": "Contrôle d'entrée/sortie via DID. Très sensible."
    },
    "0x31": {
      "name": "RoutineControl",
      "type": "routine",
      "write": true,
      "description": "Démarre, arrête ou interroge une routine de service."
    },
    "0x34": {
      "name": "RequestDownload",
      "type": "flash",
      "write": true,
      "description": "Demande de téléchargement ECU. Interdit sans procédure OEM."
    },
    "0x36": {
      "name": "TransferData",
      "type": "flash",
      "write": true,
      "description": "Transfert de données de flash. Interdit sans procédure OEM."
    },
    "0x37": {
      "name": "RequestTransferExit",
      "type": "flash",
      "write": true,
      "description": "Fin de transfert flash. Interdit sans procédure OEM."
    },
    "0x38": {
      "name": "RequestFileTransfer",
      "type": "file",
      "write": true,
      "description": "Transfert de fichier ECU. Interdit sans procédure OEM."
    },
    "0x3D": {
      "name": "WriteMemoryByAddress",
      "type": "write",
      "write": true,
      "description": "Écriture mémoire par adresse. Très sensible."
    },
    "0x3E": {
      "name": "TesterPresent",
      "type": "keepalive",
      "write": false,
      "description": "Maintient la session diagnostic ouverte."
    },
    "0x85": {
      "name": "ControlDTCSetting",
      "type": "write",
      "write": true,
      "description": "Active ou désactive l'enregistrement des DTC pendant une procédure."
    },
    "0x19": {
      "name": "ReadDTCInformation",
      "type": "read",
      "write": false,
      "description": "Lit les DTC via UDS."
    },
    "0x14": {
      "name": "ClearDiagnosticInformation",
      "type": "write",
      "write": true,
